# DevPod Start devcont-matj-debian13.devpod
Host devcont-matj-debian13.devpod
  ForwardAgent no
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/home/matj/bin/devpod" ssh --stdio --context default --user apamabld devcont-matj-debian13 --workdir "/workspaces" --agent-forwarding=false
  User apamabld
Host *
  IdentityAgent ~/.1password/agent.sock
Host *.apama.com
	User matj
	ProxyJump apamajump
	CASignatureAlgorithms +ssh-rsa
	ControlMaster auto
	ControlPersist 10m
	ControlPath ~/.ssh/master-%L-%r@%h:%p

Host looter
	HostName looter.apama.com
	User matj
	ProxyJump apamajump
	CASignatureAlgorithms +ssh-rsa
